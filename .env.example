# Copy this file to .env.local for local development.
# On Vercel, add these two variables under Project → Settings → Environment Variables.
#
# Find both in Supabase: Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# If these are left empty the app runs in "Demo mode":
# no login, and invoices are stored in the browser only.
